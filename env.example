## ReportPortal deployment configuration
## Generated 2026-08-31

## --- Active profiles ---
## core = RP services, infra = postgres/rabbitmq/gateway, analyzer = auto-analyzer,
## trailing comma = the upstream '' profile (needed for opensearch).
COMPOSE_PROFILES=core,infra,analyzer,

## --- Host ports (8080/8081 are already used on this machine) ---
RP_UI_PORT=8090
RP_TRAEFIK_PORT=8091

## --- PostgreSQL ---
POSTGRES_USER=rpuser
POSTGRES_PASSWORD=rpuser_pwd
POSTGRES_DB=reportportal

## --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=rabbitmq
RABBITMQ_DEFAULT_PASS=rabbitmq_pwd

## --- Initial superadmin password (login: superadmin) ---
## Change it in the UI after the first login.
RP_INITIAL_ADMIN_PASSWORD=admin_pwd

## --- Service image tags (pinned to the 5.15.x release line) ---
MIGRATIONS_IMAGE=reportportal/migrations:5.15.4
INDEX_IMAGE=reportportal/service-index:5.15.1
UI_IMAGE=reportportal/service-ui:5.15.5
API_IMAGE=reportportal/service-api:5.15.4
UAT_IMAGE=reportportal/service-authorization:5.15.1
JOBS_IMAGE=reportportal/service-jobs:5.15.2
ANALYZER_IMAGE=reportportal/service-auto-analyzer:5.15.5